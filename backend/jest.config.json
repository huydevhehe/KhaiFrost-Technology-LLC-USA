{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }] },
  "collectCoverageFrom": ["**/*.ts"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node"
}
