# ---------------------------------------------------------------------------
# Repository layout: frontend/ (Next.js)  backend/ (NestJS)  + local-only reference material at root
# ---------------------------------------------------------------------------

# dependencies (any depth: root, frontend/, backend/)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (frontend)
.next/
out/

# nest build output (backend)
dist/

# production
build/

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real secrets, only the .env.example templates
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend runtime data (uploaded media, logs)
backend/uploads/
backend/logs/
*.log

# playwright / tooling scratch
.playwright-mcp/
.superpowers/

# ---------------------------------------------------------------------------
# NEVER PUSHED: Markdown and Word files (any folder, any letter case)
# ---------------------------------------------------------------------------
*.md
*.MD
*.markdown
*.doc
*.DOC
*.docx
*.DOCX
*.dotx
*.rtf

# local reference materials only (business docs, design mockups, planning docs)
*.pdf
/docs/
/design*/
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.avif
/*.jfif
