# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright debug scratch (from browser-based verification)
.playwright-mcp/

# local reference materials only — never pushed (business docs, design mockups, docs/plans)
*.docx
*.pdf
*.md
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.avif
/*.jfif
/design đã dev/
